NODE_ENV=development
PORT=4000

# App runtime connection — a non-superuser role (created by migration 0001) so
# that FORCE ROW LEVEL SECURITY actually applies. Never point this at the
# superuser below.
DATABASE_URL=postgres://app_runtime:app_runtime_dev_password@localhost:5432/hospital_outreach

# Superuser connection, used ONLY by `npm run db:migrate` / drizzle-kit to
# create tables/roles. The app process never uses this.
MIGRATE_DATABASE_URL=postgres://hospital:hospital@localhost:5432/hospital_outreach

REDIS_URL=redis://localhost:6379

JWT_SECRET=dev-only-change-me
JWT_EXPIRES_IN=12h

# Phase 5 (AI Agent Layer) — not needed before then.
GEMINI_API_KEY=
